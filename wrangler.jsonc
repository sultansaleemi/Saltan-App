{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "saltan-fashion",
  "main": "worker.js",
  "compatibility_date": "2026-09-26",

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "saltan-fashion-db",
      "database_id": "5ec05a13-a941-4650-8f5a-4c3972fd10d2"
    }
  ]
}